{
  "permissions": {
    "allow": [
      "Edit(.claude/memory/**)",
      "Write(.claude/memory/**)",
      "MultiEdit(.claude/memory/**)",
      "Edit(.claude/audit.log)",
      "Write(.claude/audit.log)",
      "Edit(D:/CLAUDE/bstack/.claude/audit.log)",
      "Write(D:/CLAUDE/bstack/.claude/audit.log)",
      "Bash(echo * >> .claude/audit.log)",
      
      // 1. Allow the specific echo command with a wildcard for the content
      "Bash(echo * ) * >> D:/CLAUDE/bstack/.claude/audit.log",
      "Bash(echo * ) * >> D:\\CLAUDE\\bstack\\.claude\\audit.log",
      
      // 2. A broader wildcard for any bash command touching that file (if supported by your tool's glob engine)
      "Bash(*audit.log*)",
      
      "PowerShell(php -l *)",
      "PowerShell(Get-ChildItem *)",
      "PowerShell(New-Item -ItemType Directory *)",
      "PowerShell(Copy-Item *_backup*)",
      "Bash(npm run lint 2>&1)",
      "Bash(npx tsc --noEmit 2>&1)",
      "Bash(npx tsc --noEmit 2>&1 && npm run lint 2>&1)"
    ]
  }
}